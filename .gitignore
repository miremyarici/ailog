# ==========================================
# PYTHON & AI
# ==========================================
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
.ipynb_checkpoints/    # (Hides Google Colab/Jupyter notebook artifacts)

# ==========================================
# ENVIRONMENT VARIABLES & SECRETS
# ==========================================
.env
appsettings.Development.json
appsettings.Local.json
secrets.json

# ==========================================
# IDE & OS FILES (VERY IMPORTANT)
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/
.vs/                   # (Visual Studio's massive hidden cache folder)
*.user                 # (Unnecessary project user settings)
*.userprefs
*.suo
*.sln.docstates

# ==========================================
# DATABASE & LOGS
# ==========================================
*.sqlite3
*.db
*.log                  # (Prevents error log files from being pushed to GitHub)
logs/

# ==========================================
# .NET / C# BUILD FILES (NEVER PUSH TO GITHUB)
# ==========================================
bin/
obj/
TestResults/           # (Hides test results if you write unit tests in the future)
