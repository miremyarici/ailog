@model AIBlog.Web.Models.ProfileViewModel
@{
    Layout = "_HomepageLayout";
    ViewData["Title"] = "Profile";
}

<!-- Main Content -->
<main class="main-content" id="profileContainer">
    <!-- Profile Header -->
    <div class="profile-header">
        <!-- Cover Photo -->
        <div class="profile-cover">
            @if (!string.IsNullOrEmpty(Model.Author.CoverPhoto))
            {
                <img src="@Model.Author.CoverPhoto" alt="Cover Photo" class="cover-image" id="coverImage" />
            }
            else
            {
                <div class="cover-placeholder" id="coverPlaceholder"></div>
            }
            <!-- Edit mode: pencil icon overlay -->
            <button class="cover-edit-icon edit-icon-btn" id="coverEditBtn" title="Change cover photo">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                </svg>
            </button>
            <input type="file" id="coverFileInput" accept="image/*" style="display:none;" />
        </div>

        <!-- Profile Info -->
        <div class="profile-info-section">
            <div class="profile-avatar-wrapper">
                @if (!string.IsNullOrEmpty(Model.Author.Avatar))
                {
                    <img src="@Model.Author.Avatar" alt="@Model.Author.Name" class="profile-avatar-large" id="avatarImage" />
                }
                else
                {
                    <div class="profile-avatar-large profile-avatar-placeholder" id="avatarPlaceholder">
                        <span>@Model.Author.Name?.Substring(0, 1).ToUpper()</span>
                    </div>
                }
                <!-- Edit mode: pencil icon overlay -->
                <button class="avatar-edit-icon edit-icon-btn" id="avatarEditBtn" title="Change profile photo">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                    </svg>
                </button>
                <input type="file" id="avatarFileInput" accept="image/*" style="display:none;" />
            </div>

            <div class="profile-details">
                <div class="profile-name-row">
                    <h1 class="profile-name">@Model.Author.Name</h1>
                    <button class="edit-profile-btn" id="editProfileBtn" onclick="toggleEditMode()">Edit Profile</button>
                    <div class="profile-edit-actions" id="profileEditActions">
                        <button class="cancel-profile-btn" id="cancelEditBtn" onclick="cancelEditMode()">Cancel</button>
                        <button class="save-profile-btn" id="saveEditBtn" onclick="saveProfile()">Save</button>
                    </div>
                </div>

                <div class="profile-bio-wrapper">
                    @if (!string.IsNullOrEmpty(Model.Author.Bio))
                    {
                        <p class="profile-bio" id="profileBioDisplay">
                            <span id="profileBioText">@Model.Author.Bio</span>
                            <button class="bio-edit-icon edit-icon-btn" id="bioEditBtn" title="Edit bio">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                </svg>
                            </button>
                        </p>
                    }
                    else
                    {
                        <p class="profile-bio profile-bio-empty" id="profileBioDisplay">
                            <span id="profileBioText">No bio yet.</span>
                            <button class="bio-edit-icon edit-icon-btn" id="bioEditBtn" title="Edit bio">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                </svg>
                            </button>
                        </p>
                    }
                    <textarea class="profile-bio-textarea" id="profileBioTextarea" style="display:none;" placeholder="Write your bio..."></textarea>
                </div>

                <div class="profile-meta">
                    <span class="profile-meta-item">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                            <line x1="16" y1="2" x2="16" y2="6"/>
                            <line x1="8" y1="2" x2="8" y2="6"/>
                            <line x1="3" y1="10" x2="21" y2="10"/>
                        </svg>
                        Joined @Model.Author.CreatedAt.ToString("MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture)
                    </span>
                </div>

                <div class="profile-stats">
                    <div class="stat-item stat-clickable" onclick="openFollowersPopup(@Model.Author.Id, 'followers')">
                        <span class="stat-number">@Model.Author.FollowersCount</span>
                        <span class="stat-label">Followers</span>
                    </div>
                    <div class="stat-item stat-clickable" onclick="openFollowersPopup(@Model.Author.Id, 'following')">
                        <span class="stat-number">@Model.Author.FollowingCount</span>
                        <span class="stat-label">Following</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number">@Model.UserPosts.Count</span>
                        <span class="stat-label">Posts</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- User's Posts -->
    <div class="profile-posts-section">
        <h2 class="profile-section-title">Published Posts</h2>

        @if (Model.UserPosts.Any())
        {
            @foreach (var blog in Model.UserPosts)
            {
                <article class="blog-card" data-blog-id="@blog.Id">
                    <h2 class="blog-title">@blog.Title</h2>
                    <p class="blog-author">@blog.Author?.Name</p>
                    <p class="blog-summary">@blog.DisplaySummary</p>
                    <a asp-controller="Blog" asp-action="BlogDetail" asp-route-id="@blog.Id" class="read-more-btn">Read More</a>
                </article>
            }
        }
        else
        {
            <div class="empty-state">
                <h2>No posts yet</h2>
                <p>Start writing your first blog post!</p>
                <a asp-controller="Blog" asp-action="Write" class="read-more-btn" style="margin-top: 16px;">Write a Post</a>
            </div>
        }
    </div>
</main>

<aside class="right-sidebar">
    <partial name="_MostReadSidebar" model="Model.MostReadBlogs" />
    <partial name="_RecommendedAuthorsSidebar" model="Model.RecommendedAuthors" />
</aside>    

@section Scripts {
    <script src="~/js/profile.js"></script>
}
