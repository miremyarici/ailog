<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AI Blog</title>
    <meta name="description" content="AI Blog - Yapay zeka destekli blog platformu" />
    
    <!-- Google Fonts: Playfair Display & Source Sans Pro -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Source+Sans+Pro:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/homepage.css" asp-append-version="true" />
    
    <!-- Theme initialization - runs before page renders to prevent flash -->
    <script>
        (function() {
            var theme = localStorage.getItem('theme') || 'bright';
            if (theme !== 'bright') {
                document.documentElement.style.setProperty('--theme-transition', 'none');
            }
        })();
    </script>
</head>
<body class="homepage-body">
    <script>
        (function() {
            var theme = localStorage.getItem('theme') || 'bright';
            document.body.setAttribute('data-theme', theme);
        })();
    </script>
    <div class="homepage-layout">
        <!-- Sidebar (Sabit - Tüm Sayfalarda Ortak) -->
        <aside class="sidebar">
            <div class="logo">ailog</div>
            <nav>
                <ul class="nav-menu">
                    <li>
                        <a asp-controller="Home" asp-action="Index" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                            <span class="nav-icon">
                                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                                    <polyline points="9 22 9 12 15 12 15 22"/>
                                </svg>
                            </span>
                            <span>Home</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Blog" asp-action="Archive" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Archive" ? "active" : "")">
                            <span class="nav-icon">
                                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M21 8v13H3V8M1 3h22v5H1zM10 12h4"/>
                                </svg>
                            </span>
                            <span>Archive</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Home" asp-action="Explore" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Explore" ? "active" : "")">
                            <span class="nav-icon">
                                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <circle cx="12" cy="12" r="10"/>
                                    <line x1="2" y1="12" x2="22" y2="12"/>
                                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                                </svg>
                            </span>
                            <span>Explore</span>
                        </a>
                    </li>
                    <!-- <li>
                        <a href="/Home/Profile" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Profile" ? "active" : "")">
                            <span class="nav-icon">
                                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                    <circle cx="12" cy="7" r="4"/>
                                </svg>
                            </span>
                            <span>Profile</span>
                        </a>
                    </li> -->
                    <li>
                        <a asp-controller="Settings" asp-action="Settings" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Settings" ? "active" : "")">
                            <span class="nav-icon">
                                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <circle cx="12" cy="12" r="3"/>
                                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                                </svg>
                            </span>
                            <span>Settings</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </aside>

        <!-- Top Bar (Sabit - Tüm Sayfalarda Ortak) -->
        <header class="top-bar">
            
            <!-- Notifications -->
            <div class="notifications-wrapper" id="notificationsBtn">
                <button class="notification-icon">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                    </svg>
                    <span class="notification-badge" id="unreadBadge" style="display: none;">0</span>
                </button>
                
                <div class="notification-dropdown" id="notificationDropdown">
                    <div class="notification-header">
                        <h4>Notifications</h4>
                    </div>
                    <div class="notification-list" id="notificationList">
                        <!-- Notifications will be loaded here via AJAX -->
                    </div>
                    <div class="notification-loading" id="notificationLoading" style="display: none;">
                        <span class="loading-spinner" style="width: 14px; height: 14px; border-width: 2px;"></span>
                    </div>
                </div>
            </div>

            <div class="user-profile" id="userProfileBtn">
                <span class="user-name">@ViewBag.CurrentUserName</span>
                <div class="user-avatar">
                    @if (!string.IsNullOrEmpty(ViewBag.CurrentUserAvatar as string))
                    {
                        <img src="@ViewBag.CurrentUserAvatar" alt="@ViewBag.CurrentUserName" />
                    }
                    else
                    {
                        <span>@(ViewBag.CurrentUserName?.ToString()?.Substring(0, 1).ToUpper() ?? "U")</span>
                    }
                </div>
                <span class="dropdown-arrow">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </span>
                
                <!-- Dropdown Menu -->
                <div class="profile-dropdown" id="profileDropdown">
                    <a asp-controller="Profile" asp-action="Profile" class="dropdown-item">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        Profile
                    </a>
                    
                    
                    
                    
                    
                    
                    <a asp-controller="Home" asp-action="Help" class="dropdown-item">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                        Help
                    </a>
                    <div class="dropdown-divider"></div>
                    <a asp-controller="Account" asp-action="Logout" class="dropdown-item logout-item">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                        Logout
                    </a>
                </div>
            </div>
        </header>

        <!-- Main Content (Sayfalara Göre Değişir) -->
        @RenderBody()
        
        <!-- Floating Action Button - Write New Blog -->
        <a asp-controller="Blog" asp-action="Write" class="fab-button" title="Write new blog">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
        </a>

        <!-- Followers/Following Popup Modal -->
        <div class="followers-modal-overlay" id="followersModalOverlay" onclick="closeFollowersPopup()">
            <div class="followers-modal" onclick="event.stopPropagation()">
                <div class="followers-modal-header">
                    <h3 class="followers-modal-title" id="followersModalTitle">Followers</h3>
                    <button class="followers-modal-close" onclick="closeFollowersPopup()">&times;</button>
                </div>
                <div class="followers-modal-body" id="followersModalBody">
                    <div class="followers-loading">Loading...</div>
                </div>
            </div>
        </div>
    </div>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        // Profile dropdown toggle
        document.addEventListener('DOMContentLoaded', function() {
            const userProfile = document.getElementById('userProfileBtn');
            
            if (userProfile) {
                userProfile.addEventListener('click', function(e) {
                    e.stopPropagation();
                    this.classList.toggle('open');
                });
                
                // Close dropdown when clicking outside
                document.addEventListener('click', function(e) {
                    if (!userProfile.contains(e.target)) {
                        userProfile.classList.remove('open');
                    }
                });
            }
        });
    </script>
    <script src="~/js/global.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        function openFollowersPopup(authorId, type) {
            const overlay = document.getElementById('followersModalOverlay');
            const title = document.getElementById('followersModalTitle');
            const body = document.getElementById('followersModalBody');

            title.textContent = type === 'followers' ? 'Followers' : 'Following';
            body.innerHTML = '<div class="followers-loading">Loading...</div>';
            overlay.classList.add('active');

            fetch('/Profile/GetFollowersList?authorId=' + authorId + '&type=' + type)
                .then(res => res.json())
                .then(data => {
                    if (data.success && data.users.length > 0) {
                        body.innerHTML = data.users.map(u => `
                            <a href="/Profile/AuthorProfile/${u.id}" class="followers-user-item">
                                <div class="followers-user-avatar">
                                    ${u.avatar ? '<img src="' + u.avatar + '" alt="' + u.name + '" />' : '<span>' + u.name.charAt(0).toUpperCase() + '</span>'}
                                </div>
                                <span class="followers-user-name">${u.name}</span>
                            </a>
                        `).join('');
                    } else {
                        body.innerHTML = '<div class="followers-empty">No ' + type + ' yet.</div>';
                    }
                })
                .catch(() => {
                    body.innerHTML = '<div class="followers-empty">Failed to load.</div>';
                });
        }

        function closeFollowersPopup() {
            document.getElementById('followersModalOverlay').classList.remove('active');
        }
    </script>
</body>
</html>
