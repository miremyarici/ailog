@model AIBlog.Web.Models.BlogDetailViewModel
@{
    Layout = "_HomepageLayout";
    ViewData["Title"] = Model.BlogPost.Title;
}

<link rel="stylesheet" href="~/css/blogdetail.css" asp-append-version="true" />

<main class="main-content">
    <div class="blog-detail-container">
        <!-- Back button -->
        <a asp-controller="Home" asp-action="Index" class="back-to-home">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/>
            </svg>
            Back to Home
        </a>

        <!-- Blog Header -->
        <div class="blog-detail-header">
            <h1 class="blog-detail-title">@Model.BlogPost.Title</h1>
            <div class="blog-detail-meta">
                <a asp-controller="Profile" asp-action="AuthorProfile" asp-route-id="@Model.BlogPost.AuthorId" class="blog-detail-author-link">
                    @Model.BlogPost.Author?.Name
                </a>
                <span class="blog-meta-separator">•</span>
                <span class="blog-detail-date">@Model.BlogPost.CreatedAt.ToString("MMMM dd, yyyy", new System.Globalization.CultureInfo("en-US"))</span>
                <span class="blog-meta-separator">•</span>
                <span class="blog-detail-category">@Model.BlogPost.Category?.Name</span>
            </div>
        </div>

        <!-- Blog Content -->
        <div class="blog-detail-content">
            @Html.Raw(Model.BlogPost.Content.Replace("\n", "<br/>"))
        </div>

        <!-- Comments Section -->
        <div class="comments-section">
            <h2 class="comments-title">Comments (<span id="commentCount">@Model.Comments.Count</span>)</h2>

            <!-- Comment Form -->
            <form id="commentForm" data-post-id="@Model.BlogPost.Id">
                <div class="comment-form">
                    <div class="comment-form-avatar">
                        @if (!string.IsNullOrEmpty(ViewBag.CurrentUserAvatar as string))
                        {
                            <img src="@ViewBag.CurrentUserAvatar" alt="You" />
                        }
                        else
                        {
                            <span>@(ViewBag.CurrentUserName?.ToString()?.Substring(0, 1).ToUpper() ?? "U")</span>
                        }
                    </div>
                    <div class="comment-input-wrapper">
                        <textarea class="comment-textarea" id="commentText" placeholder="Write a comment..." required></textarea>
                        <button type="submit" class="comment-submit-btn">Comment</button>
                    </div>
                </div>
            </form>

            <!-- Comment List -->
            <div class="comment-list">
                @foreach (var comment in Model.Comments)
                {
                    <div class="comment-item" data-comment-id="@comment.Id">
                        <div class="comment-header">
                            <a asp-controller="Profile" asp-action="AuthorProfile" asp-route-id="@comment.AuthorId" class="comment-author-link" style="text-decoration: none; color: inherit; display: flex; align-items: center; gap: 0.8rem;">
                                <div class="comment-avatar">
                                    @if (!string.IsNullOrEmpty(comment.Author?.Avatar))
                                    {
                                        <img src="@comment.Author.Avatar" alt="@comment.Author.Name" />
                                    }
                                    else
                                    {
                                        <span>@comment.Author?.Name?.Substring(0, 1).ToUpper()</span>
                                    }
                                </div>
                                <span class="comment-author-name hover-underline">@comment.Author?.Name</span>
                            </a>
                            <span class="comment-date">@comment.CreatedAt.ToString("MMM dd, yyyy", new System.Globalization.CultureInfo("en-US"))</span>
                        </div>
                        <p class="comment-content">@comment.Content</p>
                        <button class="reply-btn" data-comment-id="@comment.Id">Reply</button>

                        <!-- Replies -->
                        @if (comment.Replies.Any())
                        {
                            <div class="replies-list">
                                @foreach (var reply in comment.Replies)
                                {
                                    <div class="comment-item" data-comment-id="@reply.Id">
                                        <div class="comment-header">
                                            <a asp-controller="Profile" asp-action="AuthorProfile" asp-route-id="@reply.AuthorId" class="comment-author-link" style="text-decoration: none; color: inherit; display: flex; align-items: center; gap: 0.8rem;">
                                                <div class="comment-avatar">
                                                    @if (!string.IsNullOrEmpty(reply.Author?.Avatar))
                                                    {
                                                        <img src="@reply.Author.Avatar" alt="@reply.Author.Name" />
                                                    }
                                                    else
                                                    {
                                                        <span>@reply.Author?.Name?.Substring(0, 1).ToUpper()</span>
                                                    }
                                                </div>
                                                <span class="comment-author-name hover-underline">@reply.Author?.Name</span>
                                            </a>
                                            <span class="comment-date">@reply.CreatedAt.ToString("MMM dd, yyyy", new System.Globalization.CultureInfo("en-US"))</span>
                                        </div>
                                        <p class="comment-content">@reply.Content</p>
                                        <button class="reply-btn" data-comment-id="@comment.Id">Reply</button>
                                    </div>
                                }
                            </div>
                        }

                        <!-- Reply Form -->
                        <div class="reply-form" id="replyForm-@comment.Id" data-parent-id="@comment.Id" data-post-id="@Model.BlogPost.Id">
                            <textarea class="reply-textarea" placeholder="Write a reply..."></textarea>
                            <div class="reply-actions">
                                <button type="button" class="reply-cancel-btn">Cancel</button>
                                <button type="button" class="reply-submit-btn">Reply</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/blogdetail.js" asp-append-version="true"></script>
}
