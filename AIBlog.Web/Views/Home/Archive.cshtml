@model AIBlog.Web.Models.ArchiveViewModel
@{
    ViewData["Title"] = "Archive";
    Layout = "~/Views/Shared/_HomepageLayout.cshtml";
}

<!-- Main Content -->
<main class="main-content" id="blogContainer">
    @if (Model.ReadBlogs.Any())
    {
        @foreach (var blog in Model.ReadBlogs)
        {
            <article class="blog-card" data-blog-id="@blog.Id">
                <h2 class="blog-title">@blog.Title</h2>
                <p class="blog-author">@blog.Author?.Name</p>
                <p class="blog-summary">@blog.DisplaySummary</p>
                <a href="#" class="read-more-btn">Continue Reading</a>
            </article>
        }

        @if (Model.HasMorePosts)
        {
            <div class="load-more-container" id="loadMoreContainer">
                <button class="load-more-btn" id="loadMoreBtn" data-page="2">
                    Load More
                </button>
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <h2>No read history yet</h2>
            <p>Start reading articles to build your archive!</p>
            <a href="/" class="read-more-btn">Browse Articles</a>
        </div>
    }
</main>

<!-- Right Sidebar - Filters & Sorting -->
<aside class="right-sidebar">
    <!-- Search -->
    <div class="search-box">
        <input type="text" id="searchInput" placeholder="Search by title..." value="@Model.SearchQuery" />
        <button type="button" id="searchBtn" class="search-icon">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="18" height="18">
                <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2" fill="none"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65" stroke="currentColor" stroke-width="2"/>
            </svg>
        </button>
    </div>

    <!-- Filters -->
    <section class="filter-section">
        <h3 class="section-title">Filters</h3>
        
        <!-- Time Period -->
        <div class="filter-group">
            <h4 class="filter-label">Time Period</h4>
            <div class="filter-buttons">
                <button class="filter-btn @(Model.TimePeriod == "this-week" ? "active" : "")" data-filter="timePeriod" data-value="this-week">This Week</button>
                <button class="filter-btn @(Model.TimePeriod == "this-month" ? "active" : "")" data-filter="timePeriod" data-value="this-month">This Month</button>
                <button class="filter-btn @(Model.TimePeriod == "this-year" ? "active" : "")" data-filter="timePeriod" data-value="this-year">This Year</button>
                <button class="filter-btn" data-filter="timePeriod" data-value="">Choose a date</button>
            </div>
        </div>

        <!-- Category -->
        <div class="filter-group">
            <h4 class="filter-label">Category</h4>
            <div class="filter-buttons category-filters">
                @foreach (var category in Model.Categories)
                {
                    <button class="filter-btn @(Model.CategoryId == category.Id ? "active" : "")" 
                            data-filter="categoryId" 
                            data-value="@category.Id">@category.Name</button>
                }
            </div>
        </div>

        <button class="clear-filters-btn" id="clearFilters">Clear All</button>
    </section>

    <!-- Sort -->
    <section class="sort-section">
        <h3 class="section-title">Sort by</h3>
        <div class="sort-buttons">
            <button class="sort-btn @(Model.SortBy == "newest" ? "active" : "")" data-sort="newest">Newest First</button>
            <button class="sort-btn @(Model.SortBy == "oldest" ? "active" : "")" data-sort="oldest">Oldest First</button>
            <button class="sort-btn @(Model.SortBy == "a-z" ? "active" : "")" data-sort="a-z">A-Z</button>
            <button class="sort-btn @(Model.SortBy == "z-a" ? "active" : "")" data-sort="z-a">Z-A</button>
            <button class="sort-btn @(Model.SortBy == "shortest" ? "active" : "")" data-sort="shortest">Shortest</button>
            <button class="sort-btn @(Model.SortBy == "longest" ? "active" : "")" data-sort="longest">Longest</button>
            <button class="sort-btn @(Model.SortBy == "most-popular" ? "active" : "")" data-sort="most-popular">Most Popular</button>
        </div>
    </section>
</aside>

@section Scripts {
    <script src="~/js/archive.js"></script>
}
