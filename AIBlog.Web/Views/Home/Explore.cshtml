@model AIBlog.Web.Models.ExploreViewModel
@{
    ViewData["Title"] = "Explore";
    Layout = "~/Views/Shared/_HomepageLayout.cshtml";
}

<!-- Main Content -->
<main class="main-content" id="blogContainer">
    @if (!string.IsNullOrEmpty(Model.SearchQuery))
    {
        <div class="search-results-section">
            <h3 class="section-title">Users</h3>
            @if (Model.SearchedAuthors != null && Model.SearchedAuthors.Any())
            {
                <div class="authors-grid" style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 32px;">
                    @foreach (var author in Model.SearchedAuthors)
                    {
                        <a asp-controller="Profile" asp-action="AuthorProfile" asp-route-id="@author.Id" class="author-info" style="text-decoration: none; color: inherit; display: flex; align-items: center; gap: 12px; padding: 12px; background: var(--bg-card); border-radius: 12px; border: 1px solid var(--border-color); transition: transform 0.2s, box-shadow 0.2s;">
                            <div class="author-avatar" style="width: 40px; height: 40px; border-radius: 50%; overflow: hidden; background: var(--bg-card-alt); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                @if (!string.IsNullOrEmpty(author.Avatar))
                                {
                                    <img src="@author.Avatar" alt="@author.Name" style="width: 100%; height: 100%; object-fit: cover;" />
                                }
                                else
                                {
                                    <span style="font-size: 1rem; font-weight: 600; color: var(--text-secondary);">@author.Name.Substring(0, 1).ToUpper()</span>
                                }
                            </div>
                            <span class="author-name" style="font-weight: 600; font-size: 1rem;">@author.Name</span>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="empty-state" style="margin-bottom: 32px; padding: 24px; text-align: left; background: transparent; border: 1px dashed var(--border-color);">
                    <p>No users found matching "@Model.SearchQuery".</p>
                </div>
            }

            <h3 class="section-title">Articles</h3>
        </div>
    }

    @if (Model.TrendingBlogs.Any())
    {
        @foreach (var blog in Model.TrendingBlogs)
        {
            <article class="blog-card" data-blog-id="@blog.Id">
                <h2 class="blog-title">@blog.Title</h2>
                <p class="blog-author"><a asp-controller="Profile" asp-action="AuthorProfile" asp-route-id="@blog.AuthorId" style="color: inherit; text-decoration: none;">@blog.Author?.Name</a></p>
                <p class="blog-summary">@blog.DisplaySummary</p>
                <a asp-controller="Blog" asp-action="BlogDetail" asp-route-id="@blog.Id" class="read-more-btn">Read More</a>
            </article>
        }

        @if (Model.HasMorePosts)
        {
            <div class="load-more-container" id="loadMoreContainer">
                <button class="load-more-btn" id="loadMoreBtn" data-page="2">
                    Load More
                </button>
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            @if (!string.IsNullOrEmpty(Model.SearchQuery))
            {
                <h2>No articles found</h2>
                <p>Try different keywords or filters.</p>
                <a asp-controller="Home" asp-action="Explore" class="read-more-btn" style="margin-top: 16px;">Clear Search</a>
            }
            else
            {
                <h2>No trending posts found</h2>
                <p>Check back later for trending content!</p>
                <a asp-controller="Home" asp-action="Index" class="read-more-btn">Browse Articles</a>
            }
        </div>
    }
</main>

<!-- Right Sidebar - Filters & Sorting -->
<aside class="right-sidebar">
    <!-- Search -->
    <div class="search-box">
        <input type="text" id="searchInput" placeholder="Search an article or user" value="@Model.SearchQuery" />
        <button type="button" id="searchBtn" class="search-icon">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="18" height="18">
                <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2" fill="none"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65" stroke="currentColor" stroke-width="2"/>
            </svg>
        </button>
    </div>

    <!-- Filters -->
    <section class="filter-section">
        <h3 class="section-title">Filters</h3>
        
        <!-- Time Period -->
        <div class="filter-group">
            <h4 class="filter-label">Time Period</h4>
            <div class="filter-buttons">
                <button class="filter-btn @(Model.TimePeriod == "this-week" ? "active" : "")" data-filter="timePeriod" data-value="this-week">This Week</button>
                <button class="filter-btn @(Model.TimePeriod == "this-month" ? "active" : "")" data-filter="timePeriod" data-value="this-month">This Month</button>
                <button class="filter-btn @(Model.TimePeriod == "this-year" ? "active" : "")" data-filter="timePeriod" data-value="this-year">This Year</button>
                <button class="filter-btn @(Model.TimePeriod == "custom" ? "active" : "")" id="chooseDateBtn" data-filter="timePeriod" data-value="custom">Choose a date</button>
            </div>
        </div>

        <!-- Category -->
        <div class="filter-group">
            <h4 class="filter-label">Category</h4>
            <div class="filter-buttons category-filters">
                @foreach (var category in Model.Categories)
                {
                    <button class="filter-btn @(Model.CategoryId == category.Id ? "active" : "")" 
                            data-filter="categoryId" 
                            data-value="@category.Id">@category.Name</button>
                }
            </div>
        </div>

        <button class="clear-filters-btn" id="clearFilters">Clear All</button>
    </section>

    <!-- Sort -->
    <section class="sort-section">
        <h3 class="section-title">Sort by</h3>
        <div class="sort-buttons">
            <button class="sort-btn @(Model.SortBy == "most-popular" ? "active" : "")" data-sort="most-popular">Most Popular</button>
            <button class="sort-btn @(Model.SortBy == "newest" ? "active" : "")" data-sort="newest">Newest First</button>
            <button class="sort-btn @(Model.SortBy == "oldest" ? "active" : "")" data-sort="oldest">Oldest First</button>
            <button class="sort-btn @(Model.SortBy == "a-z" ? "active" : "")" data-sort="a-z">A-Z</button>
            <button class="sort-btn @(Model.SortBy == "z-a" ? "active" : "")" data-sort="z-a">Z-A</button>
        </div>
    </section>
</aside>

<!-- Date Picker Modal -->
<div class="date-picker-modal" id="datePickerModal">
    <div class="date-picker-overlay" id="datePickerOverlay"></div>
    <div class="date-picker-content">
        <h3 class="date-picker-title">Select Date</h3>
        <div class="date-picker-selects">
            <div class="date-select-group">
                <label>Day</label>
                <select id="daySelect"></select>
            </div>
            <div class="date-select-group">
                <label>Month</label>
                <select id="monthSelect"></select>
            </div>
            <div class="date-select-group">
                <label>Year</label>
                <select id="yearSelect"></select>
            </div>
        </div>
        <div class="date-picker-actions">
            <button class="date-picker-save-btn" id="datePickerSave">Save</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/explore.js"></script>
}
